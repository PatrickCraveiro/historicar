# Copie este arquivo para .env.local e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# String de conexão do MongoDB Atlas (Database > Connect > Drivers).
MONGODB_URI="mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="historicar"

# Segredo que assina o login. Gere um texto aleatório longo (mínimo 32 caracteres), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Endereço DEFINITIVO do site, sem barra no final. Vai dentro do QR code:
# se ele mudar depois, os QRs já impressos param de funcionar.
APP_URL="http://localhost:3000"

# Nome que aparece no painel, na página do QR, no adesivo e no PDF.
SHOP_NAME="Doutor Automóvel"
